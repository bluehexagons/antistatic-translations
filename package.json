{
  "name": "@bluehexagons/antistatic-translations",
  "version": "0.1.74",
  "description": "Fluent translation files used by Antistatic",
  "homepage": "https://github.com/bluehexagons/antistatic-translations#readme",
  "bugs": {
    "url": "https://github.com/bluehexagons/antistatic-translations/issues"
  },
  "license": "CC-BY-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/antistatic-translations.git"
  },
  "files": [
    "*.ftl",
    "index.js",
    "README.md",
    "license.md"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./*.ftl": "./*.ftl",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check",
    "format": "oxfmt --write .oxfmtrc.json .oxlintrc.json index.js package.json README.md",
    "format:check": "oxfmt --check .oxfmtrc.json .oxlintrc.json index.js package.json README.md",
    "lint": "oxlint index.js --deny-warnings",
    "lint:fix": "oxlint index.js --fix --deny-warnings"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
